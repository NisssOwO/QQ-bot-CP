QQBOT_APPID=
QQBOT_SECRET=

# LLM provider route. The default is an OpenAI-compatible relay.
LLM_PROVIDER=relay
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_DISPLAY_NAME=OpenAI-compatible relay

QQBOT_REQUIRE_MENTION=true
QQBOT_STREAMING=true
QQBOT_SESSION_IDLE_TIMEOUT=1800000
